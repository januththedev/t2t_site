{
  "name": "trace-theory-to-trade",
  "version": "1.0.0",
  "private": true,
  "description": "T2T by TRACE — React, TypeScript and Material UI with static HTML and grounded chat",
  "scripts": {
    "build": "node --import tsx scripts/build.mjs",
    "predev": "npm run build",
    "dev": "node --watch --env-file-if-exists=.env.local scripts/dev.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
